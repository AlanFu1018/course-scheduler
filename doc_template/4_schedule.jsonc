// ============================================================================
// 4. schedule — 排程計畫（每位使用者的資料列；每次排程／重排產生一筆）
//    對應模組圖：#2 LLM 產生讀書計畫 → #3 排程原因說明
//    只放「這一次排程」層級的資訊：為什麼排、排哪段期間、整體想法、比重分配
//    任務本身（內容 + 狀態）與時段 → 見 5_tasks
//
//    SQLite：schedules(plan_id PK, user_id, status, created_at, data JSON)
//
//    重排規則：
//      - 新版只涵蓋 scope.from 之後、狀態不是 done / skipped 的任務
//      - 沿用的任務保留原 task_id，只更新其內容與 tasks.plan_id；內容大改則開新 task_id
//      - 不再需要的任務在 tasks 標 superseded；locked = true 的時段照原樣保留
//      - 舊版 status 改 superseded，不刪除（保留歷史）
// ============================================================================
{
  "schema_version": "1.5",
  "plan_id": "p_0007",
  "user_id": "u_0001",
  "created_at": "2026-11-13T21:00:00+08:00",
  "status": "active",                    // active | superseded | draft（使用者尚未確認）
  "supersedes": "p_0006",                // 被取代的前一版

  // 觸發原因：initial | completion_feedback | user_adjust | course_update | calendar_update | missed_tasks
  "trigger": "completion_feedback",
  "trigger_ref": "t_0042",               // 觸發來源（task_id / course_key …），可為 null

  // 本次排程範圍；from 之前的不動
  "scope": {
    "from": "2026-11-14",
    "to": "2026-12-25",
    "course_keys": ["115-1_CE3005"]      // 空陣列 = 全部課程
  },

  // 整份計畫的排程原因說明；個別任務的原因放在 tasks.reason
  "summary": "Ch3 理解度低（2/5），加排 Ch3 複習；期末範圍 Ch4 開始安排閱讀。",

  // AI 認為的比重分配：本版各評量分到多少時間、為什麼
  "allocation": [
    { "course_key": "115-1_CE3005", "assessment_id": "final", "minutes": 165, "share": 1.0,
      "reason": "期末占 30% 且 Ch3 需補強；本週無其他評量" }
  ],

  // 本版包含的任務快照（tasks.plan_id 只記「最後一次」排到它的版本，這裡保留每版的完整清單）
  "task_ids": ["t_0051", "t_0052"],

  "model": "claude-opus-5-5"             // 產生計畫的模型，方便追查品質
}
